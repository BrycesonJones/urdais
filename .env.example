# Urdais environment variables
#
# Copy this file to `.env.local` for local development. `.env.local` and other
# real environment files are git-ignored; never commit secrets.
#
# Variables prefixed with NEXT_PUBLIC_ are inlined into the browser bundle.
# Server-only secrets must NOT use the NEXT_PUBLIC_ prefix.

# --- Application ---------------------------------------------------------
# Public origin of the web app (no trailing slash). Used for absolute URLs
# and metadata. Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_APP_URL=

# --- Supabase (development backend) ---------------------------------------
# The hosted development project is UrdaisDev. Its project reference is not a
# secret: it appears in every public API URL for the project. The Supabase CLI
# records the same reference in the git-ignored supabase/.temp/ after
# `supabase link`. Everything else below is a secret and lives only in
# .env.local or the shell, never in git.
SUPABASE_PROJECT_REF=scwwjoyouohfrwylalha
#
# Needed only by whoever applies migrations to the hosted project by CLI
# (`supabase db push`). PR CI never uses it and never touches UrdaisDev.
#   SUPABASE_DB_PASSWORD=
#
# Not wired up yet. Populate when the application gains a database client:
#   NEXT_PUBLIC_SUPABASE_URL=
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
#   SUPABASE_SERVICE_ROLE_KEY=

# --- Future integrations (not wired up yet) ------------------------------
# These sections will be populated when the corresponding slices are built.
# Do not add values here until the integration exists.
#
# Urdais API:
#   NEXT_PUBLIC_API_URL=
#
# Analytics (PostHog):
#   NEXT_PUBLIC_POSTHOG_KEY=
#   NEXT_PUBLIC_POSTHOG_HOST=
#
# Cache (Upstash Redis, server-only):
#   UPSTASH_REDIS_REST_URL=
#   UPSTASH_REDIS_REST_TOKEN=
