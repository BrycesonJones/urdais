# Urdais environment variables
#
# Copy this file to `.env.local` for local development. `.env.local` and other
# real environment files are git-ignored; never commit secrets.
#
# Variables prefixed with NEXT_PUBLIC_ are inlined into the browser bundle.
# Server-only secrets must NOT use the NEXT_PUBLIC_ prefix.

# --- Application ---------------------------------------------------------
# Public origin of the web app (no trailing slash). Used for absolute URLs
# and metadata. Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_APP_URL=

# --- Supabase (development backend) ---------------------------------------
# The hosted development project is UrdaisDev. Its project reference is not a
# secret: it appears in every public API URL for the project. The Supabase CLI
# records the same reference in the git-ignored supabase/.temp/ after
# `supabase link`. Everything else below is a secret and lives only in
# .env.local or the shell, never in git.
SUPABASE_PROJECT_REF=scwwjoyouohfrwylalha
#
# Needed only by whoever applies migrations to the hosted project by CLI
# (`supabase db push`). PR CI never uses it and never touches UrdaisDev.
#   SUPABASE_DB_PASSWORD=
#
# Not wired up yet. Populate when the application gains a database client:
#   NEXT_PUBLIC_SUPABASE_URL=
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
#   SUPABASE_SERVICE_ROLE_KEY=
#
# Token-price catalog (server-only). `loadTokenReadCatalog()` reads
# pipeline.token_price_observations. In `next dev`, if unset, the loader
# uses the local harness URL from `scripts/db/local.sh url`
# (postgresql://postgres@localhost:54329/urdais_local). Production never
# uses that default and never publishes research-only rows.
#   DATABASE_URL=
#   URDAIS_DATABASE_URL=

# --- Supabase (production backend) -----------------------------------------
# The hosted production project is UrdaisProd. It is a separate database from
# UrdaisDev and is never a copy of it: its migration history was applied from
# zero, and the only rows it holds beyond schema seeds are manually verified
# production observations. The reference is not a secret, for the same reason
# the development one is not.
SUPABASE_PRODUCTION_PROJECT_REF=cyqtaydtfuwaexjkuynq
#
# A deployed instance needs DATABASE_URL pointing at UrdaisProd, and nothing
# else. Two things about that string are easy to get wrong:
#   - use the session pooler (aws-0-us-east-1.pooler.supabase.com:5432, user
#     postgres.<ref>). The direct db.<ref>.supabase.co host is IPv6-only.
#   - Supabase presents its own certificate authority, so a default
#     verify-full fails. Download the project CA from the dashboard and append
#     sslmode=verify-full&sslrootcert=<path>.
# NODE_ENV=production is what selects the fail-closed production read path.
# See docs/operations/production-environments.md.
#   DATABASE_URL=

# --- UCPI collector runtime (server-only; no value here is ever committed) --
# Read only by src/lib/ucpi/runtime/config.ts, and only at run time. The
# runtime refuses production or validation retrieval when a source is not
# production-approved in the registry, when no permission grant is in force,
# or when the credential below is absent. Simulation mode needs none of these.
#
# Run mode: simulation (default; fixtures only, no network) | validation
# (live credentialed retrieval, evidence only, never publishes) | production.
UCPI_RUN_MODE=simulation
#
# Documented API hosts. Configuration, not assumptions; confirmed at first
# authenticated validation. The registry records the Runpod catalog under
# https://api.runpod.io and the Lambda instance types under https://cloud.lambda.ai.
#   UCPI_RUNPOD_BASE_URL=https://api.runpod.io
#   UCPI_LAMBDA_BASE_URL=https://cloud.lambda.ai
#   UCPI_PRICE_OF_COMPUTE_BASE_URL=https://priceofcompute.com   (keyless; 1,000 requests/day; attribution required)
#
# Provider API keys. Server-only. Never logged, never in errors, never here.
#   RUNPOD_API_KEY=
#   LAMBDA_API_KEY=

# --- Future integrations (not wired up yet) ------------------------------
# These sections will be populated when the corresponding slices are built.
# Do not add values here until the integration exists.
#
# Urdais API:
#   NEXT_PUBLIC_API_URL=
#
# Analytics (PostHog):
#   NEXT_PUBLIC_POSTHOG_KEY=
#   NEXT_PUBLIC_POSTHOG_HOST=
#
# Cache (Upstash Redis, server-only):
#   UPSTASH_REDIS_REST_URL=
#   UPSTASH_REDIS_REST_TOKEN=
