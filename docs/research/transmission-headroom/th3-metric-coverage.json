  "crossMarketAndRejected": [
    {
      "metric": "total_transmission_headroom_mw",
      "market": "cross_market",
      "state": "not_defensible",
      "reason": "NYISO's population is a census of published transfer interfaces; ERCOT's is whichever constraints dispatch was managing. A sum would add two different questions."
    },
    {
      "metric": "average_transmission_headroom_mw",
      "market": "cross_market",
      "state": "not_defensible",
      "reason": "Same population mismatch; an average hides it rather than resolving it."
    },
    {
      "metric": "combined_constrained_element_count",
      "market": "cross_market",
      "state": "not_defensible",
      "reason": "Incompatible denominators: NYISO's is a fixed roster of 19, ERCOT's is the tracked subset of thousands."
    },
    {
      "metric": "national_headroom_mw",
      "market": "cross_market",
      "state": "not_defensible",
      "reason": "Two markets are not a nation, and neither observes its own network in full."
    },
    {
      "metric": "market_wide_historical_average",
      "market": "nyiso",
      "state": "deferred",
      "reason": "NYISO is an irregular event series, so an arithmetic mean over observations is neither time-weighted nor entity-weighted. Deferred rather than resolved by defaulting to whichever weighting a chart prefers."
    },
    {
      "metric": "percent_of_ercot_network_constrained",
      "market": "ercot",
      "state": "not_defensible",
      "reason": "The denominator is invisible: an element with abundant margin never appears in NP6-86-CD."
    },
    {
      "metric": "unconstrained_network_capacity",
      "market": "cross_market",
      "state": "not_defensible",
      "reason": "Neither source observes unconstrained elements at all."
    },
    {
      "metric": "planning_transfer_margin",
      "market": "cross_market",
      "state": "not_defensible",
      "reason": "V1 is operational only. Planning headroom is a separate future product with a different time basis, topology and contingency set."
    },
    {
      "metric": "available_transfer_capability",
      "market": "cross_market",
      "state": "not_defensible",
      "reason": "ATC is a scheduling capability concept, not flow-to-limit headroom. CAISO's ATC exceeded TTC in 27.7% of direction-intervals because it nets counterflow, and its usage column was empty in 100% of rows, so no flow term exists."
    }
  ],
